# ============================================================================
# 環境變數範本 — 複製為 .env 並填入實際值（.env 已由 .gitignore 排除，勿提交）
# ============================================================================
# 用法：
#   1. cp .env.example .env
#   2. 填入下列值
#   3. 載入方式：import core 時會自動載入本檔（見 core/env.py），一般無須手動 source。
#      若子行程在 import core 前就讀 os.environ（如 preflight 直接讀），可先：
#        set -a; source .env; set +a          # 手動載入到 shell
#        或在指令前帶入：BEDROCK_KB_ID=... python -m core.pipeline
#      shell 既有值優先（core/env.py 以 override=False 載入，不覆蓋既設值）。
#
# AWS 憑證不放這裡，交給 ~/.aws/（aws configure）管理，避免外洩。

# ---------------------------------------------------------------------------
# Bedrock Knowledge Base（RAG 檢索）★ 最重要
# ---------------------------------------------------------------------------
# 未設定 BEDROCK_KB_ID 時，kb.retrieve() 會「靜默回 mock」而不報錯——
# 即使關掉 dry-run 也只會拿到假檢索結果。要跑真實檢索務必設定此值。
# 本專案的 KB（單一 KB + metadata 過濾，Cohere Embed v3，S3 Vectors）：
BEDROCK_KB_ID=NEUMFUYMOI

# （可選）各案由專用 KB。有設定者該案由走專用 KB，其餘 fallback 到 BEDROCK_KB_ID。
# 本專案採「單一 KB」策略，通常不需設定以下：
# BEDROCK_KB_ID_MONEY_LAUNDERING=
# BEDROCK_KB_ID_WASTE=
# BEDROCK_KB_ID_AIR_POLLUTION=
# BEDROCK_KB_ID_BUILDING=
# BEDROCK_KB_ID_NOISE=
# BEDROCK_KB_ID_GENERAL=

# 檢索過濾撈空時是否退回純語意檢索（預設開啟，1）
# BEDROCK_KB_FILTER_FALLBACK=1

# ---------------------------------------------------------------------------
# 區域與模型
# ---------------------------------------------------------------------------
AWS_REGION=us-west-2

# Claude Sonnet 4.5 / Haiku 4.5 必須用 inference profile ID（us. 前綴），
# 裸模型 ID 的 on-demand 呼叫會 ValidationException。
BEDROCK_MODEL_WRITER=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_MODEL_LIGHT=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_EMBED_MODEL=cohere.embed-multilingual-v3

# ---------------------------------------------------------------------------
# 限流與執行模式
# ---------------------------------------------------------------------------
# 兩次 Bedrock 呼叫的最小間隔秒數（≤1 RPS 規範，1.05 留安全邊際）
BEDROCK_MIN_INTERVAL=1.05

# 1 = 不呼叫真實 Bedrock/KB，回 mock（離線骨架驗證用）；0 = 真實呼叫
BEDROCK_DRY_RUN=0

# 1 = 整趟強制不讀寫快取，每個 LLM 呼叫都真實發出（驗證端到端真呼叫 / 現場 demo）；
# 0 = 啟用快取（預設，較快但相同輸入會回快取而不真打）。
BEDROCK_NO_CACHE=0

# （可選）跨行程限流狀態檔位置，預設放系統暫存目錄
# BEDROCK_RATE_STATE=

# ---------------------------------------------------------------------------
# henry 前段（S3 訴願書來源）— 僅跑 henry/ 腳本時需要
# ---------------------------------------------------------------------------
# APPEAL_S3_BUCKET=bucket-jahseh
# APPEAL_PDF_PREFIX=原始訴願書v2_pdf/
# APPEAL_TEST_PDF_PREFIX=測試訴願書_pdf/
# APPEAL_ANSWER_KEY=appeals_structured.jsonl
